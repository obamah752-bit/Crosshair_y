<Window x:Class="crosshair_y.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Y Settings"
        Width="540" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="40" Top="40"
        FontFamily="Segoe UI"
        TextElement.FontSize="13">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="#F1E7FF"/>
            <Setter Property="Background" Value="#383842"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#5A4873"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30263F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#2A2A33"/>
            <Setter Property="Foreground" Value="#F1E7FF"/>
            <Setter Property="BorderBrush" Value="#68577F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CaretBrush" Value="#C8A2FF"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E9DCFF"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#C8A2FF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="NumericValueBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <EventSetter Event="GotKeyboardFocus" Handler="NumericValueBox_GotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NumericValueBox_PreviewMouseLeftButtonDown"/>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#695286" Margin="2,1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="5"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#9D78C9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#C8A2FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#18181D" BorderBrush="#5B4A70" BorderThickness="1" CornerRadius="12">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="DragArea_MouseDown">
                <StackPanel>
                    <TextBlock Text="CROSSHAIR Y" Foreground="#F1E7FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Best Free Crosshair Overlay" Foreground="#B5A4CA" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="&#x00D7;" Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="30" Height="30" Padding="0" Background="#292932" FontSize="18"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#222229" CornerRadius="9" Padding="8">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="8,8,0,10"/>
                        <Button x:Name="SettingsTabButton" Content="Settings" Click="SettingsTab_Click"
                                Height="38" HorizontalContentAlignment="Left" Background="#4C3A68" FontWeight="SemiBold"/>
                        <Button x:Name="SavedTabButton" Content="Saved presets" Click="SavedTab_Click"
                                Height="38" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,5,0,0"/>
                        <Button x:Name="CommunityTabButton" Content="Community" Click="CommunityTab_Click"
                                Height="38" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#222229" CornerRadius="9">
                    <Grid>
                    <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Visible" Padding="16">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="0,0,0,9"/>
                            <Border Background="#2A2A33" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Crosshair colour" Foreground="#F1E7FF" FontWeight="SemiBold"/>
                                    <TextBlock Text="Choose a quick colour or use a custom one." Foreground="#B5A4CA" FontSize="11" Margin="0,2,0,9"/>
                                    <WrapPanel>
                                        <Button Width="32" Height="32" Background="Lime" Margin="0,0,6,0" Padding="0" Click="ColorButton_Click" Tag="Lime"/>
                                        <Button Width="32" Height="32" Background="Red" Margin="0,0,6,0" Padding="0" Click="ColorButton_Click" Tag="Red"/>
                                        <Button Width="32" Height="32" Background="Cyan" Margin="0,0,6,0" Padding="0" Click="ColorButton_Click" Tag="Cyan"/>
                                        <Button Width="32" Height="32" Background="Magenta" Margin="0,0,6,0" Padding="0" Click="ColorButton_Click" Tag="Magenta"/>
                                        <Button Width="32" Height="32" Background="White" Margin="0,0,6,0" Padding="0" Click="ColorButton_Click" Tag="White"/>
                                        <Button Width="32" Height="32" Background="Yellow" Padding="0" Click="ColorButton_Click" Tag="Yellow"/>
                                    </WrapPanel>
                                    <Button Content="Custom colour…" Click="CustomColorButton_Click" HorizontalAlignment="Left"
                                            Margin="0,12,0,0" Background="#383842"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="LINES" Style="{StaticResource SectionLabel}" Margin="0,0,0,9"/>
                            <Border Background="#2A2A33" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Arm length" Foreground="#F1E7FF"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Width="62" Height="25" HorizontalContentAlignment="Right" ToolTip="Type a value, then press Enter"
                                                     Text="{Binding ElementName=SizeSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                     KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                            <TextBlock Text="px" Foreground="#B5A4CA" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="SizeSlider" Minimum="2" Maximum="40" Value="5" SmallChange="0.1" LargeChange="1" ValueChanged="SizeSlider_ValueChanged" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Line thickness" Foreground="#F1E7FF"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Width="62" Height="25" HorizontalContentAlignment="Right" ToolTip="Type a value, then press Enter"
                                                     Text="{Binding ElementName=ThicknessSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                     KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                            <TextBlock Text="px" Foreground="#B5A4CA" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="10" Value="2" SmallChange="0.1" LargeChange="1" ValueChanged="ThicknessSlider_ValueChanged" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Centre gap" Foreground="#F1E7FF"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Width="62" Height="25" HorizontalContentAlignment="Right" ToolTip="Type a value, then press Enter"
                                                     Text="{Binding ElementName=GapSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                     KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                            <TextBlock Text="px" Foreground="#B5A4CA" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="GapSlider" Minimum="0" Maximum="30" Value="4" SmallChange="0.1" LargeChange="1" ValueChanged="GapSlider_ValueChanged" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Overall opacity" Foreground="#F1E7FF"/>
                                        <TextBox Width="62" Height="25" HorizontalAlignment="Right" HorizontalContentAlignment="Right" ToolTip="Use a value from 0.10 to 1.00, then press Enter"
                                                 Text="{Binding ElementName=OpacitySlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                  KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                    </Grid>
                                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="OpacitySlider_ValueChanged"/>

                                    <CheckBox x:Name="OutlineCheck" Content="Black outline around all crosshair edges" IsChecked="True" Margin="0,12,0,0" Click="OutlineCheck_Click"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="CENTRE ELEMENTS" Style="{StaticResource SectionLabel}" Margin="0,0,0,9"/>
                            <Border Background="#2A2A33" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="DotCheck" Content="Centre dot" IsChecked="False" Click="DotCheck_Click"/>
                                    <Grid Margin="0,8,0,3">
                                        <TextBlock Text="Dot size" Foreground="#F1E7FF"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Width="62" Height="25" HorizontalContentAlignment="Right" ToolTip="Type a value, then press Enter"
                                                     Text="{Binding ElementName=DotSizeSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                     KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                            <TextBlock Text="px" Foreground="#B5A4CA" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="DotSizeSlider" Minimum="1" Maximum="20" Value="3" SmallChange="0.1" LargeChange="1" ValueChanged="DotSizeSlider_ValueChanged" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Dot opacity" Foreground="#F1E7FF"/>
                                        <TextBox Width="62" Height="25" HorizontalAlignment="Right" HorizontalContentAlignment="Right" ToolTip="Use a value from 0.10 to 1.00, then press Enter"
                                                 Text="{Binding ElementName=DotOpacitySlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                  KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                    </Grid>
                                    <Slider x:Name="DotOpacitySlider" Minimum="0.1" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="DotOpacitySlider_ValueChanged"/>

                                    <Separator Margin="0,14,0,9" Background="#5B4A70"/>

                                    <CheckBox x:Name="CircleCheck" Content="Centre circle" Click="CircleCheck_Click"/>
                                    <Grid Margin="0,8,0,3">
                                        <TextBlock Text="Circle radius" Foreground="#F1E7FF"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Width="62" Height="25" HorizontalContentAlignment="Right" ToolTip="Type a value, then press Enter"
                                                     Text="{Binding ElementName=CircleRadiusSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                     KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                            <TextBlock Text="px" Foreground="#B5A4CA" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="CircleRadiusSlider" Minimum="2" Maximum="100" Value="15" SmallChange="0.1" LargeChange="1" ValueChanged="CircleRadiusSlider_ValueChanged" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Circle opacity" Foreground="#F1E7FF"/>
                                        <TextBox Width="62" Height="25" HorizontalAlignment="Right" HorizontalContentAlignment="Right" ToolTip="Use a value from 0.10 to 1.00, then press Enter"
                                                 Text="{Binding ElementName=CircleOpacitySlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                                                  KeyDown="NumericValueBox_KeyDown" Style="{StaticResource NumericValueBox}"/>
                                    </Grid>
                                    <Slider x:Name="CircleOpacitySlider" Minimum="0.1" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="CircleOpacitySlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="VISIBLE ARMS" Style="{StaticResource SectionLabel}" Margin="0,0,0,9"/>
                            <Border Background="#2A2A33" CornerRadius="8" Padding="14">
                                <WrapPanel>
                                    <CheckBox x:Name="TopCheck" Content="Top" IsChecked="True" Width="50" Click="LineCheck_Click"/>
                                    <CheckBox x:Name="BottomCheck" Content="Bottom" IsChecked="True" Width="70" Click="LineCheck_Click"/>
                                    <CheckBox x:Name="LeftCheck" Content="Left" IsChecked="True" Width="50" Click="LineCheck_Click"/>
                                    <CheckBox x:Name="RightCheck" Content="Right" IsChecked="True" Width="60" Click="LineCheck_Click"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="SavedPanel" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="SAVED PRESETS" Style="{StaticResource SectionLabel}" Margin="0,0,0,9"/>
                            <Border Background="#2A2A33" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PresetNameBox" Height="34" VerticalContentAlignment="Center" ToolTip="Preset name"/>
                                    <Button Grid.Column="2" Content="Save current" Click="SaveCurrentButton_Click" Height="34" Background="#4C3A68"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#2A2A33" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SavedListPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="CommunityPanel" Visibility="Collapsed" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="COMMUNITY CROSSHAIRS" Style="{StaticResource SectionLabel}" Margin="0,0,0,9"/>
                            <TextBlock Text="Browse presets from a public GitHub repository. No server or account is needed to download them."
                                       Foreground="#B5A4CA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#2A2A33" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="GitHub community catalog" Foreground="#F1E7FF" FontWeight="SemiBold"/>
                                    <TextBlock Text="obamah752-bit/Crosshair_y · catalog.json"
                                               Foreground="#B5A4CA" FontSize="11" Margin="0,2,0,7"/>
                                    <Button Content="Refresh catalog" Click="RefreshCommunityButton_Click" Height="34" Background="#4C3A68" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Name your crosshair before publishing" Foreground="#F1E7FF" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                    <TextBox x:Name="CommunityPresetNameBox" Height="34" VerticalContentAlignment="Center" ToolTip="Community crosshair name"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,12,0,12">
                            <TextBlock Text="DISCOVER" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button x:Name="CommunityTopButton" Content="Top all-time" Click="CommunitySortButton_Click" Tag="Top" Background="#4C3A68" Margin="0,0,6,0"/>
                                <Button x:Name="CommunityWeekButton" Content="Popular this week" Click="CommunitySortButton_Click" Tag="Week" Background="#383842" Margin="0,0,6,0"/>
                                <Button x:Name="CommunityNewButton" Content="New releases" Click="CommunitySortButton_Click" Tag="New" Background="#383842"/>
                            </WrapPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CommunityStatusText" Foreground="#B5A4CA" VerticalAlignment="Center" Text="Loading community catalog…" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Content="Publish mine" Click="PublishCommunityButton_Click" Background="#383842"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#2A2A33" CornerRadius="8" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CommunityListPanel"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
